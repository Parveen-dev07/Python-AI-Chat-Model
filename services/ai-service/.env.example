# Service
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI provider: openai | gemini
AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT_SECONDS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Customer database (dev single-tenant; server-side only)
# Use postgresql+psycopg:// for the Python psycopg3 driver (not plain postgresql://)
CUSTOMER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/your_database

DB_QUERY_TIMEOUT_SECONDS=10
DB_MAX_ROWS=100
# Comma-separated schemas the AI may query (must match your DB)
DB_ALLOWED_SCHEMAS=public,auth,admin

# Tenant / widget (dev)
DEFAULT_WIDGET_ID=demo-widget
DEFAULT_TENANT_ID=demo-tenant
WIDGET_PUBLIC_TITLE=Ask our database
WIDGET_THEME=light

# Backend authentication (widget sends this header; not a DB credential)
API_KEY=dev-api-key-change-me

# Rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=30
